{
  "expo": {
    "name": "Pondo Hub",
    "slug": "pondo-hub",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pondohub.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#087F5B",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pondohub.app",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Pondo Hub",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#087F5B",
          "image": "./assets/icon.png",
          "imageWidth": 130
        }
      ]
    ],
    "scheme": "pondohub",
    "extra": {
      "eas": {
        "projectId": "df90fb0e-a57e-472e-aae0-8a1baae3ab42"
      }
    },
    "owner": "jrvsai"
  }
}
