{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pondohub.vercel.app",
        "EXPO_PUBLIC_SITE_URL": "https://pondohub.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pondohub.vercel.app",
        "EXPO_PUBLIC_SITE_URL": "https://pondohub.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
